# Copy this file to .env and adjust as needed.
# `make dev` / `docker compose up` both read from .env.

# --- API ---
PORT=8080
DATABASE_URL=postgres://polaris:polaris@localhost:5433/polaris?sslmode=disable
JWT_SECRET=change-me-in-production
JWT_TTL_HOURS=24

# --- Object storage (S3-compatible; MinIO locally) ---
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=polaris
S3_SECRET_KEY=polaris123
S3_BUCKET=polaris
S3_USE_SSL=false

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8080
